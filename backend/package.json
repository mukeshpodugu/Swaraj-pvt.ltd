{
  "name": "financepro-backend",
  "version": "1.0.0",
  "description": "Production-ready Backend for Swaraj FinancePro AI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src -e js --exec \"esbuild src/index.js --bundle --platform=node --target=node20 --outfile=dist/index.js && node dist/index.js\"",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.12.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.13",
    "pdfkit": "^0.15.0"
  },
  "devDependencies": {
    "esbuild": "^0.20.2",
    "nodemon": "^3.1.0",
    "prisma": "^5.12.1"
  }
}
